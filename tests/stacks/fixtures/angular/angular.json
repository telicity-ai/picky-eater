{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "trailhead": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": { "browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.app.json", "styles": ["src/trailhead.css"] },
          "configurations": { "development": { "optimization": false, "extractLicenses": false, "sourceMap": true } },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": { "development": { "buildTarget": "trailhead:build:development" } },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
